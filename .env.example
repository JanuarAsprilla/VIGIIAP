# URL de la API
# En dev dejar vacío — Vite usa el proxy a http://localhost:4000
# En producción apuntar al backend desplegado
VITE_API_URL=

# URL del bucket público de R2 (imágenes, thumbnails)
# Ejemplo: https://media.vigiiap.iiap.gov.co
VITE_R2_PUBLIC_URL=


# Entorno de la app (development | production)
VITE_APP_ENV=development
